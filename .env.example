PORT=3001
# Exact browser origin. For phones, replace localhost with your LAN IP in development.
PUBLIC_ORIGIN=http://localhost:3001
# Shared username is host. Set a unique 15–256 character passphrase; never commit it.
HOST_PASSWORD=
# PostgreSQL required in production. Omit for local SQLite; use a CLEAN v0.5.1 database.
DATABASE_URL=
SQLITE_PATH=data/arcade-v051.sqlite
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAIL_KEY=
# preview is development-only. Production needs smtp and a configured sender.
MAIL_MODE=preview
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BCUSCA Arcade <arcade@example.com>
# Set true after restoring a backup until reconciliation is complete.
RECONCILIATION_REQUIRED=false

# Test-only catalogue until beginner acceptance. These games are never Ranked in this release.
ENABLE_PROTOTYPE_GAMES=false
