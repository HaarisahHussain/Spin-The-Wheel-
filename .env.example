PORT=3001
PUBLIC_ORIGIN=http://192.168.1.13:3001 # Update this based on one's network in deployment or actual URL in production
# PostgreSQL required in production. SQLite is used locally when omitted.
DATABASE_URL=
SQLITE_PATH=data/arcade.sqlite
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAIL_KEY=
# preview is development-only. Actual deployment uses SMTP.
MAIL_MODE=preview
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BCUSCA Arcade <arcade@example.com>
# Set true after restoring a backup until reconciliation is complete.
RECONCILIATION_REQUIRED=false
