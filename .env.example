PORT=3001
# Exact browser origin. For phones, replace localhost with your LAN IP in development.
PUBLIC_ORIGIN=http://localhost:3001
# Shared username is host. Set a unique 15–256 character passphrase; never commit it.
HOST_PASSWORD=
# PostgreSQL required in production. Omit for local SQLite. Existing schema-7 v0.6.0 data upgrades automatically.
DATABASE_URL=
# Only enable deliberately for a separate remote development database.
ALLOW_REMOTE_DEV_DATABASE=false
SQLITE_PATH=data/arcade-v060.sqlite
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAIL_KEY=
# preview is development-only. Production needs smtp and a configured sender.
MAIL_MODE=preview
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BCUSCA Arcade <arcade@example.com>
# Set true after restoring a backup until reconciliation is complete.
RECONCILIATION_REQUIRED=false

