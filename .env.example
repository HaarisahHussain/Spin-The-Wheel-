PORT=3001
# Exact browser origin; use your laptop's LAN IP for phone testing.
PUBLIC_ORIGIN=http://localhost:3001
# Shared host username is host. Use a unique 15–256 character passphrase.
HOST_PASSWORD=
# PostgreSQL required for production; leave empty for development SQLite.
DATABASE_URL=
ALLOW_REMOTE_DEV_DATABASE=false
SQLITE_PATH=data/arcade.sqlite
# Stable 64-character hex key for encrypted credential receipts.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When omitted, generated locally in data/receipt.key; retain this file.
RECEIPT_KEY=
# Keep admissions paused after restoring a database until records are checked.
RECONCILIATION_REQUIRED=false
