{
  "name": "bcusca-arcade",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js --production",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "lint": "oxlint --deny-warnings",
    "check": "npm run lint && npm test && npm run build",
    "staff": "node --env-file-if-exists=.env scripts/staff.js"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.6",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.0.3",
    "otpauth": "^9.4.0",
    "pg": "^8.16.0",
    "prismjs": "^1.30.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.5.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sparticuz/chromium": "^152.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
